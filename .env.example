# ============================================================
# D365 Job Hunter - Environment Variables Configuration
# ============================================================

# Google OAuth & Gmail Dispatch
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
CALLBACK_URL=https://d365-job-hunter-app.vercel.app/auth/callback

# Groq AI (LLaMA 3.3 for email & resume personalization)
GROQ_API_KEY=gsk_your_groq_api_key

# Adzuna REST API (Real D365 Job Discovery)
# Register for free developer API access at: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Apollo API (Verified Recruiter Contact Lookup)
APOLLO_API_KEY=your_apollo_api_key

# Google Sheets Telemetry & Tracker
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# JSONBin Storage (Candidates & LinkedIn Queue)
JSONBIN_BIN_ID=your_candidates_bin_id
JSONBIN_MASTER_KEY=your_jsonbin_master_key
LINKEDIN_BIN_ID=your_linkedin_bin_id

# Upstash Redis (Duplicate Application Tracker & History)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Vercel Blob Storage (Resume Storage)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token

# Automation & Security
RUN_NOW_SECRET=your_run_now_secret
SESSION_SECRET=d365jobhunter2026secret
PORT=3000

# Mock Jobs Toggle (true for isolated local test fixtures, false for real discovery)
USE_MOCK_JOBS=false
