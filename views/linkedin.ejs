<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LinkedIn Posts - D365 Job Hunter</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f1923; color: #fff; min-height: 100vh; }
    .navbar { background: #1a2a3a; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; }
    .logo { font-size: 20px; font-weight: 800; color: #00d4ff; text-decoration: none; }
    .nav-links a { color: #8899aa; text-decoration: none; font-size: 14px; margin-left: 20px; }
    .container { max-width: 800px; margin: 40px auto; padding: 0 20px; }
    h1 { font-size: 32px; color: #00d4ff; margin-bottom: 8px; }
    .subtitle { color: #8899aa; margin-bottom: 30px; }
    .card { background: #1a2a3a; border-radius: 12px; padding: 30px; margin-bottom: 20px; }
    .card h2 { font-size: 18px; color: #00d4ff; margin-bottom: 20px; }
    .form-group { margin-bottom: 20px; }
    label { display: block; font-size: 14px; color: #8899aa; margin-bottom: 8px; }
    input, textarea { width: 100%; padding: 12px 15px; background: #0f1923; border: 1px solid #2a3a4a; border-radius: 8px; color: #fff; font-size: 15px; }
    textarea { height: 180px; resize: vertical; }
    .btn { width: 100%; padding: 15px; background: #00d4ff; color: #000; border: none; border-radius: 8px; font-size: 16px; font-weight: 700; cursor: pointer; }
    .btn:hover { background: #00b8d9; }
    .btn:disabled { background: #334455; color: #8899aa; cursor: not-allowed; }
    .status-box { border-radius: 8px; padding: 15px 20px; margin-bottom: 20px; display: none; }
    .status-sending { background: #00d4ff22; border: 1px solid #00d4ff; color: #00d4ff; }
    .status-success { background: #00ff8822; border: 1px solid #00ff88; color: #00ff88; }
    .status-error { background: #ff444422; border: 1px solid #ff4444; color: #ff4444; }
    .results-box { background: #0f1923; border-radius: 8px; padding: 20px; margin-top: 15px; display: none; }
    .result-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #1a2a3a; font-size: 14px; }
    .sent { color: #00ff88; }
    .failed { color: #ff4444; }
    .spinner { display: inline-block; width: 20px; height: 20px; border: 3px solid #00d4ff33; border-top: 3px solid #00d4ff; border-radius: 50%; animation: spin 1s linear infinite; margin-right: 10px; vertical-align: middle; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .tab-group { display: flex; gap: 10px; margin-bottom: 20px; }
    .tab { padding: 10px 20px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 600; border: 1px solid #2a3a4a; background: #0f1923; color: #8899aa; }
    .tab.active { background: #00d4ff; color: #000; border-color: #00d4ff; }
    .tab-content { display: none; }
    .tab-content.active { display: block; }
    .upload-area { border: 2px dashed #2a3a4a; border-radius: 8px; padding: 40px; text-align: center; cursor: pointer; transition: border-color 0.2s; }
    .upload-area:hover { border-color: #00d4ff; }
    .upload-icon { font-size: 40px; margin-bottom: 10px; }
    .posts-list { display: grid; gap: 10px; }
    .post-item { background: #0f1923; border-radius: 8px; padding: 15px; border-left: 3px solid #00d4ff; }
    .post-company { font-weight: 700; color: #00d4ff; font-size: 15px; }
    .post-text { font-size: 13px; color: #8899aa; margin-top: 5px; }
    .post-meta { font-size: 12px; color: #445566; margin-top: 8px; }
    .badge { padding: 3px 8px; border-radius: 20px; font-size: 11px; font-weight: 600; margin-left: 8px; }
    .badge-sent { background: #00ff8822; color: #00ff88; }
    .badge-pending { background: #ffaa0022; color: #ffaa00; }
  </style>
</head>
<body>
  <div class="navbar">
    <a href="/" class="logo">🚀 D365 Job Hunter</a>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/linkedin">Post Jobs</a>
      <% if (user) { %><a href="/logout">Logout (<%= user.displayName %>)</a><% } else { %><a href="/auth/google">Login</a><% } %>
    </div>
  </div>

  <div class="container">
    <h1>📱 Post a Job → Instant Email Blast!</h1>
    <p class="subtitle">Paste a LinkedIn post, JD, or upload an image → Emails sent immediately from ALL candidates! 🚀</p>

    <div id="statusBox" class="status-box"></div>
    <div id="resultsBox" class="results-box"></div>

    <% if (user) { %>
    <div class="card">
      <h2>➕ Add Job Post</h2>

      <div class="tab-group">
        <div class="tab active" onclick="switchTab('text')">📝 Paste Text/JD</div>
        <div class="tab" onclick="switchTab('image')">🖼️ Upload Image</div>
      </div>

      <!-- TEXT TAB -->
      <div id="tab-text" class="tab-content active">
        <div class="form-group">
          <label>Recruiter Email (if visible in post)</label>
          <input type="email" id="emailInput" placeholder="e.g. john.smith@capgemini.com (optional)">
        </div>
        <div class="form-group">
          <label>Paste LinkedIn Post / Job Description *</label>
          <textarea id="textInput" placeholder="Paste the full LinkedIn post or job description here...&#10;&#10;Example:&#10;We are hiring Senior D365 CRM Developer at Capgemini Hyderabad...&#10;Skills: C#.NET, Power Platform, Azure...&#10;Contact: john.smith@capgemini.com"></textarea>
        </div>
        <div class="form-group">
          <label>Post URL (optional)</label>
          <input type="url" id="urlInput" placeholder="https://linkedin.com/posts/...">
        </div>
        <button class="btn" id="submitBtn" onclick="submitPost()">
          🚀 Send Emails to All Candidates NOW!
        </button>
      </div>

      <!-- IMAGE TAB -->
      <div id="tab-image" class="tab-content">
        <div class="form-group">
          <label>Recruiter Email (if visible in image)</label>
          <input type="email" id="imageEmailInput" placeholder="e.g. john.smith@capgemini.com (optional)">
        </div>
        <div class="form-group">
          <label>Upload Screenshot/Image of Job Post</label>
          <div class="upload-area" onclick="document.getElementById('imageFile').click()">
            <div class="upload-icon">🖼️</div>
            <div id="uploadText">Click to upload LinkedIn screenshot or job post image</div>
            <div style="font-size:12px;color:#556677;margin-top:8px">Supports: JPG, PNG, WEBP</div>
            <input type="file" id="imageFile" accept="image/*" style="display:none" onchange="previewImage(this)">
          </div>
          <div id="imagePreview" style="margin-top:10px;display:none">
            <img id="previewImg" style="max-width:100%;border-radius:8px;max-height:300px">
          </div>
        </div>
        <button class="btn" id="imageSubmitBtn" onclick="submitImage()">
          🚀 Send Emails to All Candidates NOW!
        </button>
      </div>
    </div>
    <% } else { %>
    <div class="card" style="text-align:center;padding:40px">
      <div style="font-size:50px;margin-bottom:15px">🔐</div>
      <p style="color:#8899aa;margin-bottom:20px">Please login to post jobs and trigger emails</p>
      <a href="/auth/google" style="padding:12px 30px;background:#00d4ff;color:#000;border-radius:8px;text-decoration:none;font-weight:700">Login with Google</a>
    </div>
    <% } %>

    <div class="card">
      <h2>📋 Recent Posts (<%= posts.length %>)</h2>
      <% if (posts.length === 0) { %>
        <p style="color:#8899aa">No posts yet. Add your first job post above!</p>
      <% } else { %>
        <div class="posts-list">
          <% posts.slice(0, 10).forEach(post => { %>
            <div class="post-item">
              <div class="post-company">
                <%= post.company || '⏳ Processing...' %>
                <span class="badge <%= post.emailsSent ? 'badge-sent' : 'badge-pending' %>">
                  <%= post.emailsSent ? '✅ ' + post.emailsSent + ' emails sent' : '⏳ Pending' %>
                </span>
              </div>
              <div class="post-text"><%= (post.text || '').substring(0, 150) %>...</div>
              <div class="post-meta">
                Added: <%= new Date(post.addedAt).toLocaleString('en-IN') %>
                <% if (post.hrEmail) { %> · HR: <%= post.hrEmail %><% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>

  <script>
    function switchTab(tab) {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
      document.getElementById('tab-' + tab).classList.add('active');
      event.target.classList.add('active');
    }

    function previewImage(input) {
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => {
          document.getElementById('previewImg').src = e.target.result;
          document.getElementById('imagePreview').style.display = 'block';
          document.getElementById('uploadText').textContent = '✅ ' + input.files[0].name;
        };
        reader.readAsDataURL(input.files[0]);
      }
    }

    function showStatus(type, message) {
      const box = document.getElementById('statusBox');
      box.className = 'status-box status-' + type;
      box.innerHTML = message;
      box.style.display = 'block';
    }

    function showResults(results) {
      const box = document.getElementById('resultsBox');
      if (!results || results.length === 0) return;
      
      let html = '<h3 style="color:#00d4ff;margin-bottom:15px">📧 Email Results:</h3>';
      results.forEach(r => {
        html += `<div class="result-row">
          <span>${r.candidate} → ${r.company}</span>
          <span>${r.sent ? '<span class="sent">✅ Sent</span>' : '<span class="failed">❌ Failed</span>'}</span>
        </div>`;
      });
      box.innerHTML = html;
      box.style.display = 'block';
    }

    async function submitPost() {
      const text = document.getElementById('textInput').value.trim();
      if (!text) { showStatus('error', '⚠️ Please paste a job post first!'); return; }

      const btn = document.getElementById('submitBtn');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner"></span> Sending emails...';
      showStatus('sending', '<span class="spinner"></span> AI is reading the post and sending emails to all candidates...');
      document.getElementById('resultsBox').style.display = 'none';

      try {
        const res = await fetch('/linkedin/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            text,
            email: document.getElementById('emailInput').value,
            url: document.getElementById('urlInput').value,
            type: 'text'
          })
        });

        const data = await res.json();

        if (data.success) {
          showStatus('success', `✅ Done! ${data.emailsSent} emails sent successfully from all candidates!`);
          showResults(data.results);
          document.getElementById('textInput').value = '';
          document.getElementById('emailInput').value = '';
          setTimeout(() => location.reload(), 3000);
        } else {
          showStatus('error', '❌ Error: ' + (data.error || 'Something went wrong'));
        }
      } catch(e) {
        showStatus('error', '❌ Network error: ' + e.message);
      }

      btn.disabled = false;
      btn.innerHTML = '🚀 Send Emails to All Candidates NOW!';
    }

    async function submitImage() {
      const file = document.getElementById('imageFile').files[0];
      if (!file) { showStatus('error', '⚠️ Please upload an image first!'); return; }

      const btn = document.getElementById('imageSubmitBtn');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner"></span> Reading image and sending emails...';
      showStatus('sending', '<span class="spinner"></span> AI is reading the image and sending emails to all candidates...');

      const reader = new FileReader();
      reader.onload = async e => {
        try {
          const res = await fetch('/linkedin/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              imageBase64: e.target.result,
              email: document.getElementById('imageEmailInput').value,
              type: 'image'
            })
          });

          const data = await res.json();

          if (data.success) {
            showStatus('success', `✅ Done! ${data.emailsSent} emails sent successfully!`);
            showResults(data.results);
            setTimeout(() => location.reload(), 3000);
          } else {
            showStatus('error', '❌ Error: ' + (data.error || 'Something went wrong'));
          }
        } catch(e) {
          showStatus('error', '❌ Error: ' + e.message);
        }

        btn.disabled = false;
        btn.innerHTML = '🚀 Send Emails to All Candidates NOW!';
      };
      reader.readAsDataURL(file);
    }
  </script>
</body>
</html>
