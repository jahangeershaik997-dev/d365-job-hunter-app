<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LinkedIn Posts - D365 Job Hunter</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f1923; color: #fff; min-height: 100vh; }
    .navbar { background: #1a2a3a; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; }
    .logo { font-size: 20px; font-weight: 800; color: #00d4ff; text-decoration: none; }
    .nav-links a { color: #8899aa; text-decoration: none; font-size: 14px; margin-left: 20px; }
    .container { max-width: 800px; margin: 40px auto; padding: 0 20px; }
    h1 { font-size: 32px; color: #00d4ff; margin-bottom: 8px; }
    .subtitle { color: #8899aa; margin-bottom: 30px; }
    .card { background: #1a2a3a; border-radius: 12px; padding: 30px; margin-bottom: 20px; }
    .card h2 { font-size: 18px; color: #00d4ff; margin-bottom: 20px; }
    .form-group { margin-bottom: 20px; }
    label { display: block; font-size: 14px; color: #8899aa; margin-bottom: 8px; }
    input, textarea { width: 100%; padding: 12px 15px; background: #0f1923; border: 1px solid #2a3a4a; border-radius: 8px; color: #fff; font-size: 15px; }
    input:focus, textarea:focus { outline: none; border-color: #00d4ff; }
    textarea { height: 150px; resize: vertical; }
    .btn { width: 100%; padding: 15px; background: #00d4ff; color: #000; border: none; border-radius: 8px; font-size: 16px; font-weight: 700; cursor: pointer; }
    .btn:hover { background: #00b8d9; }
    .success { background: #00ff8822; border: 1px solid #00ff88; border-radius: 8px; padding: 15px; margin-bottom: 20px; color: #00ff88; }
    .posts-list { display: grid; gap: 15px; }
    .post-item { background: #0f1923; border-radius: 8px; padding: 15px 20px; border-left: 3px solid #00d4ff; }
    .post-company { font-weight: 700; color: #00d4ff; }
    .post-text { font-size: 13px; color: #8899aa; margin-top: 5px; }
    .post-meta { font-size: 12px; color: #556677; margin-top: 8px; }
    .badge { padding: 3px 8px; border-radius: 20px; font-size: 11px; font-weight: 600; background: #00d4ff22; color: #00d4ff; margin-left: 8px; }
    .how-to { background: #0f1923; border-radius: 8px; padding: 20px; margin-bottom: 20px; }
    .step { display: flex; gap: 15px; margin-bottom: 12px; align-items: flex-start; }
    .step-num { background: #00d4ff; color: #000; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 13px; flex-shrink: 0; }
    .step-text { font-size: 14px; color: #ccc; padding-top: 4px; }
  </style>
</head>
<body>
  <div class="navbar">
    <a href="/" class="logo">🚀 D365 Job Hunter</a>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/linkedin">LinkedIn Posts</a>
      <% if (user) { %><a href="/logout">Logout</a><% } %>
    </div>
  </div>

  <div class="container">
    <h1>📱 LinkedIn Recruiter Posts</h1>
    <p class="subtitle">Paste recruiter posts here → System sends applications automatically!</p>

    <% if (success) { %>
      <div class="success">✅ Post saved! Emails will be sent in the next run.</div>
    <% } %>

    <div class="card">
      <h2>How It Works</h2>
      <div class="how-to">
        <div class="step">
          <div class="step-num">1</div>
          <div class="step-text">See a recruiter post on LinkedIn about a D365 job</div>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <div class="step-text">Copy the full post text</div>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <div class="step-text">Paste it below with recruiter's email (if visible)</div>
        </div>
        <div class="step">
          <div class="step-num">4</div>
          <div class="step-text">AI reads the post, writes personalized email, sends from each candidate's Gmail with resume attached!</div>
        </div>
      </div>
    </div>

    <% if (user) { %>
    <div class="card">
      <h2>➕ Add LinkedIn Post</h2>
      <form action="/linkedin" method="POST">
        <div class="form-group">
          <label>Recruiter's Email (if visible in post)</label>
          <input type="email" name="email" placeholder="e.g. john.smith@capgemini.com">
        </div>
        <div class="form-group">
          <label>LinkedIn Post Text *</label>
          <textarea name="text" placeholder="Paste the full LinkedIn recruiter post here..." required></textarea>
        </div>
        <div class="form-group">
          <label>Post URL (optional)</label>
          <input type="url" name="url" placeholder="https://linkedin.com/posts/...">
        </div>
        <button type="submit" class="btn">🚀 Save & Queue for Sending</button>
      </form>
    </div>
    <% } else { %>
    <div class="card" style="text-align:center">
      <p style="color:#8899aa;margin-bottom:20px">Please login to add LinkedIn posts</p>
      <a href="/auth/google" style="padding:12px 30px;background:#00d4ff;color:#000;border-radius:8px;text-decoration:none;font-weight:700">Login with Google</a>
    </div>
    <% } %>

    <div class="card">
      <h2>📋 Saved Posts (<%= posts.length %>)</h2>
      <% if (posts.length === 0) { %>
        <p style="color:#8899aa">No posts added yet. Add your first LinkedIn post above!</p>
      <% } else { %>
        <div class="posts-list">
          <% posts.forEach(post => { %>
            <div class="post-item">
              <div class="post-company">
                <%= post.company || 'Parsing...' %>
                <span class="badge"><%= post.processed ? '✅ Sent' : '⏳ Pending' %></span>
              </div>
              <div class="post-text"><%= post.text ? post.text.substring(0, 150) + '...' : '' %></div>
              <div class="post-meta">
                Added: <%= new Date(post.addedAt).toLocaleDateString('en-IN') %>
                <% if (post.email) { %> · Email: <%= post.email %><% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
