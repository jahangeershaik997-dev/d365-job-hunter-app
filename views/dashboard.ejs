<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - D365 Job Hunter</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f1923; color: #fff; min-height: 100vh; }
    .navbar { background: #1a2a3a; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; }
    .logo { font-size: 20px; font-weight: 800; color: #00d4ff; }
    .nav-links { display: flex; gap: 15px; align-items: center; }
    .nav-links a { color: #8899aa; text-decoration: none; font-size: 14px; }
    .nav-links a:hover { color: #00d4ff; }
    .container { max-width: 1200px; margin: 0 auto; padding: 30px 20px; }
    h1 { font-size: 32px; color: #00d4ff; margin-bottom: 5px; }
    .welcome { color: #8899aa; margin-bottom: 30px; }
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px; }
    .card { background: #1a2a3a; border-radius: 12px; padding: 25px; }
    .card-icon { font-size: 30px; margin-bottom: 10px; }
    .card-num { font-size: 36px; font-weight: 800; color: #00d4ff; }
    .card-label { font-size: 13px; color: #8899aa; margin-top: 5px; }
    .section { background: #1a2a3a; border-radius: 12px; padding: 25px; margin-bottom: 20px; }
    .section h2 { font-size: 18px; color: #00d4ff; margin-bottom: 15px; }
    .profile-row { display: flex; gap: 20px; flex-wrap: wrap; }
    .profile-item { background: #0f1923; border-radius: 8px; padding: 12px 20px; }
    .profile-label { font-size: 11px; color: #8899aa; }
    .profile-value { font-size: 15px; font-weight: 600; margin-top: 3px; }
    .not-registered { text-align: center; padding: 40px; }
    .not-registered p { color: #8899aa; margin-bottom: 20px; }
    .btn { padding: 12px 25px; background: #00d4ff; color: #000; border-radius: 8px; text-decoration: none; font-weight: 700; display: inline-block; }
    .candidates-list { display: grid; gap: 10px; }
    .candidate-row { background: #0f1923; border-radius: 8px; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; }
    .candidate-name { font-weight: 600; }
    .candidate-meta { font-size: 13px; color: #8899aa; margin-top: 3px; }
    .badge { padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .badge-blue { background: #00d4ff22; color: #00d4ff; }
    .sheet-link { color: #00d4ff; text-decoration: none; }
    .schedule-info { background: #0f1923; border-radius: 8px; padding: 15px 20px; }
    .schedule-time { font-size: 24px; font-weight: 800; color: #00d4ff; }
    .schedule-desc { color: #8899aa; font-size: 13px; margin-top: 5px; }
  </style>
</head>
<body>
  <div class="navbar">
    <div class="logo">🚀 D365 Job Hunter</div>
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/register">Register</a>
      <a href="/logout">Logout (<%= user.displayName %>)</a>
    </div>
  </div>

  <div class="container">
    <h1>Dashboard</h1>
    <p class="welcome">Welcome back, <%= user.displayName %>! 👋</p>

    <div class="cards">
      <div class="card">
        <div class="card-icon">👥</div>
        <div class="card-num"><%= candidates.length %></div>
        <div class="card-label">Candidates Registered</div>
      </div>
      <div class="card">
        <div class="card-icon">⏰</div>
        <div class="card-num">9 AM</div>
        <div class="card-label">Daily Auto-Apply IST</div>
      </div>
      <div class="card">
        <div class="card-icon">📊</div>
        <div class="card-num">Live</div>
        <div class="card-label">Google Sheet Tracking</div>
      </div>
      <div class="card">
        <div class="card-icon">🤖</div>
        <div class="card-num">Groq</div>
        <div class="card-label">AI Email Writer</div>
      </div>
    </div>

    <% if (candidate) { %>
      <div class="section">
        <h2>📋 Your Profile</h2>
        <div class="profile-row">
          <div class="profile-item">
            <div class="profile-label">NAME</div>
            <div class="profile-value"><%= candidate.name %></div>
          </div>
          <div class="profile-item">
            <div class="profile-label">EMAIL</div>
            <div class="profile-value"><%= candidate.email %></div>
          </div>
          <div class="profile-item">
            <div class="profile-label">EXPERIENCE</div>
            <div class="profile-value"><%= candidate.experience %> Years</div>
          </div>
          <div class="profile-item">
            <div class="profile-label">ROLE</div>
            <div class="profile-value"><%= candidate.role %></div>
          </div>
          <div class="profile-item">
            <div class="profile-label">STATUS</div>
            <div class="profile-value" style="color:#00d4ff">✅ Active</div>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="section">
        <div class="not-registered">
          <div style="font-size:50px;margin-bottom:15px">⚠️</div>
          <p>You haven't completed your registration yet!</p>
          <a href="/register" class="btn">Complete Registration</a>
        </div>
      </div>
    <% } %>

    <div class="section">
      <h2>⏰ Automation Schedule</h2>
      <div class="schedule-info">
        <div class="schedule-time">Every Day 9:00 AM IST</div>
        <div class="schedule-desc">
          Script automatically scrapes D365 jobs → Finds HR emails → AI writes personalized email → Sends from YOUR Gmail → Updates Google Sheet
        </div>
      </div>
    </div>

    <div class="section">
      <h2>📊 Google Sheet Tracker</h2>
      <p style="color:#8899aa;margin-bottom:15px">View all jobs applied and their status:</p>
      <a href="https://docs.google.com/spreadsheets/d/1DZpavtALZ0lyAPbeSEUbsfna3COIumHPWP_G-q8UziY" target="_blank" class="btn">Open Google Sheet 📊</a>
    </div>

    <div class="section">
      <h2>👥 All Candidates (<%= candidates.length %>)</h2>
      <% if (candidates.length === 0) { %>
        <p style="color:#8899aa">No candidates registered yet. Share the registration link!</p>
      <% } else { %>
        <div class="candidates-list">
          <% candidates.forEach(c => { %>
            <div class="candidate-row">
              <div>
                <div class="candidate-name"><%= c.name %></div>
                <div class="candidate-meta"><%= c.email %> · <%= c.role %></div>
              </div>
              <span class="badge badge-blue"><%= c.experience %> Years</span>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <div class="section">
      <h2>🔗 Share Registration Link</h2>
      <p style="color:#8899aa;margin-bottom:15px">Share this with all candidates:</p>
      <div style="background:#0f1923;border-radius:8px;padding:15px;font-family:monospace;color:#00d4ff;word-break:break-all">
        https://d365-job-hunter-app.vercel.app/register
      </div>
    </div>
  </div>
</body>
</html>
