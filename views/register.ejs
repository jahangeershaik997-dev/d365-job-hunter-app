<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - D365 Job Hunter</title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    body { display: flex; align-items: center; justify-content: center; padding: 20px; }
    .reg-card { width: 100%; max-width: 500px; padding: 40px; }
    .reg-card h1 { font-size: 26px; color: var(--accent); margin-bottom: 8px; }
    .reg-card .subtitle { color: var(--text-muted); margin-bottom: 28px; font-size: 14px; }
    .step-box { background: var(--bg-inset); border-radius: var(--radius-sm); padding: 15px; margin-bottom: 20px; border: 1px solid var(--border); }
    .step-title { font-size: 11px; color: var(--text-muted); letter-spacing: 0.5px; margin-bottom: 4px; }
    .step-desc { font-size: 14px; }
  </style>
</head>
<body>
  <div class="card reg-card">
    <h1>🚀 Join D365 Job Hunter</h1>
    <p class="subtitle">Register once. Get jobs applied automatically every day!</p>

    <% if (error) { %>
      <div class="alert alert-error">⚠️ <%= error %></div>
    <% } %>

    <% if (!user) { %>
      <div class="step-box">
        <div class="step-title">STEP 1</div>
        <div class="step-desc">Login with your Gmail first</div>
      </div>
      <a href="/auth/google" class="btn-google btn-block">
        <img src="https://www.google.com/favicon.ico" width="20" height="20" alt="">
        Login with Google
      </a>
    <% } else { %>
      <div class="step-box">
        <div class="step-title">✅ LOGGED IN AS</div>
        <div class="step-desc"><%= user.displayName %> · <%= user.email %></div>
      </div>

      <form action="/register" method="POST" enctype="multipart/form-data">
        <div class="form-group">
          <label>Full Name</label>
          <input type="text" name="name" value="<%= user.displayName %>" required>
        </div>

        <div class="form-group">
          <label>Current Role</label>
          <input type="text" name="role" placeholder="e.g. Senior D365 CRM Developer" required>
        </div>

        <div class="form-group">
          <label>Years of Experience</label>
          <select name="experience" required>
            <option value="">Select experience</option>
            <option value="3">3 Years</option>
            <option value="4">4 Years</option>
            <option value="5">5 Years</option>
            <option value="6">6 Years</option>
            <option value="7">7+ Years</option>
          </select>
        </div>

        <div class="form-group">
          <label>Upload Resume (PDF or Word)</label>
          <div class="upload-area" onclick="document.getElementById('resumeFile').click()">
            <div class="upload-icon">📄</div>
            <div class="upload-text">Click to upload your resume</div>
            <input type="file" id="resumeFile" name="resume" accept=".pdf,.docx" style="display:none" required onchange="document.querySelector('.upload-text').textContent = this.files[0].name">
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block">✅ Register &amp; Start Applying!</button>
      </form>
    <% } %>
  </div>
</body>
</html>
