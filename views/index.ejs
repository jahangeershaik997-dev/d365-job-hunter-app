<!DOCTYPE html>
<html>
<head>
  <title>D365 Job Hunter</title>
  <style>
    body { font-family: Arial; text-align: center; padding: 50px; }
    .container { max-width: 600px; margin: 0 auto; }
    h1 { color: #0078D4; }
    .btn { padding: 12px 30px; font-size: 16px; background: #0078D4; color: white; border: none; border-radius: 5px; cursor: pointer; }
  </style>
</head>
<body>
  <div class="container">
    <h1>🚀 D365 Job Hunter</h1>
    <p>Automated job application system for D365 professionals</p>
    <% if (user) { %>
      <p>Welcome, <%= user.displayName %>!</p>
      <a href="/dashboard" class="btn">Go to Dashboard</a>
      <a href="/logout" class="btn" style="background: #666; margin-left: 10px;">Logout</a>
    <% } else { %>
      <a href="/auth/google" class="btn">Login with Google</a>
      <a href="/register" class="btn" style="background: #666; margin-left: 10px;">Register</a>
    <% } %>
  </div>
</body>
</html>
