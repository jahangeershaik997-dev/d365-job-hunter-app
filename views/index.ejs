<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>D365 Job Hunter</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f1923; color: #fff; min-height: 100vh; }
    .hero { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 40px 20px; text-align: center; }
    .logo { font-size: 60px; margin-bottom: 20px; }
    h1 { font-size: 48px; font-weight: 800; color: #00d4ff; margin-bottom: 10px; }
    .subtitle { font-size: 20px; color: #8899aa; margin-bottom: 40px; }
    .stats { display: flex; gap: 40px; margin-bottom: 50px; }
    .stat { background: #1a2a3a; border-radius: 12px; padding: 20px 30px; }
    .stat-num { font-size: 36px; font-weight: 800; color: #00d4ff; }
    .stat-label { font-size: 14px; color: #8899aa; margin-top: 5px; }
    .buttons { display: flex; gap: 15px; flex-wrap: wrap; justify-content: center; }
    .btn { padding: 15px 35px; border-radius: 8px; font-size: 16px; font-weight: 600; text-decoration: none; cursor: pointer; border: none; display: inline-block; }
    .btn-primary { background: #00d4ff; color: #000; }
    .btn-secondary { background: #1a2a3a; color: #fff; border: 1px solid #00d4ff; }
    .features { display: flex; gap: 20px; margin-top: 60px; flex-wrap: wrap; justify-content: center; }
    .feature { background: #1a2a3a; border-radius: 12px; padding: 20px; width: 200px; }
    .feature-icon { font-size: 30px; margin-bottom: 10px; }
    .feature-title { font-size: 14px; font-weight: 600; color: #00d4ff; }
    .feature-desc { font-size: 12px; color: #8899aa; margin-top: 5px; }
  </style>
</head>
<body>
  <div class="hero">
    <div class="logo">🚀</div>
    <h1>D365 Job Hunter</h1>
    <p class="subtitle">Automated job applications for Microsoft Dynamics 365 professionals</p>

    <div class="stats">
      <div class="stat">
        <div class="stat-num"><%= candidateCount %></div>
        <div class="stat-label">Candidates Registered</div>
      </div>
      <div class="stat">
        <div class="stat-num">9 AM</div>
        <div class="stat-label">Daily Auto-Apply</div>
      </div>
      <div class="stat">
        <div class="stat-num">FREE</div>
        <div class="stat-label">Powered by Groq AI</div>
      </div>
    </div>

    <div class="buttons">
      <% if (user) { %>
        <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
        <a href="/logout" class="btn btn-secondary">Logout</a>
      <% } else { %>
        <a href="/auth/google" class="btn btn-primary">🔑 Login with Google</a>
        <a href="/register" class="btn btn-secondary">Register Now</a>
      <% } %>
    </div>

    <div class="features">
      <div class="feature">
        <div class="feature-icon">🔍</div>
        <div class="feature-title">Auto Scrape</div>
        <div class="feature-desc">Scrapes Indeed & LinkedIn daily</div>
      </div>
      <div class="feature">
        <div class="feature-icon">🤖</div>
        <div class="feature-title">AI Emails</div>
        <div class="feature-desc">Groq AI writes personalized emails</div>
      </div>
      <div class="feature">
        <div class="feature-icon">📧</div>
        <div class="feature-title">Auto Send</div>
        <div class="feature-desc">Sends from YOUR Gmail</div>
      </div>
      <div class="feature">
        <div class="feature-icon">📊</div>
        <div class="feature-title">Track All</div>
        <div class="feature-desc">Google Sheet tracking</div>
      </div>
    </div>
  </div>
</body>
</html>
